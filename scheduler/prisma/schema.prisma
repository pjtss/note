datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Schedule {
  id          String   @id @default(uuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  category    String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("schedules")
}
