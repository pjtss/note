datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Schedule {
  id          String   @id @default(uuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  category    String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("schedules")
}

model Memo {
  id        String   @id @default(uuid())
  title     String
  content   String?
  color     String   @default("#2b2d42")
  createdAt DateTime @default(now())

  @@map("memos")
}
